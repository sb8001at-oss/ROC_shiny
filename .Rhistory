thre_f <- function(x){
judge <- ifelse(d$detection > x, "positive", "negative")
true_negative <- sum(d$outcome == "good" & judge == "negative")/nrow(d)
true_positive <- sum(d$outcome == "poor" & judge == "positive")/nrow(d)
c(threshold = x, true_negative = true_negative, true_positive = true_positive)
}
thre_vec <- seq(min(d$detection), max(d$detection), by = 0.1)
# これがROC（false_positiveを横軸，true_negativeを縦軸に取ったもの）っぽいもの（Ｘ軸が逆，多分true_positiveを取り，X軸を逆順にする必要がある）
roc_d <- mapply(thre_f, thre_vec) |> t() |> as.data.frame()
roc_d |>
ggplot(aes(x = true_negative |> vec_to_percent(), y = true_positive |> vec_to_percent())) +
geom_path()+
scale_x_reverse()
roc_d$true_negative * 100 / nrow(roc_d) / 10000
sum(roc_d$true_negative * 100 / nrow(roc_d)) / 10000
100 / nrow(roc_d)
head(d$true_positive |> vec_to_percent(), -1)
1:000 |> head(-1)
1:100 |> head(-1)
auc_f <- function(d){
step = 100 / nrow(d)
v1 <- head(d$true_positive |> vec_to_percent(), -1)
v2 <- d$true_positive |> vec_to_percent() |> _[-1]
sum((v1 - v2) * step)
}
auc_f(roc_d)
library(pROC)
library(ggplot2)
set.seed(1)
v_negative <- rnorm(100, 20, 10)
v_positive <- rnorm(100, 45, 10)
d <-
data.frame(
outcome = rep(c("good", "poor"), c(100, 100)),
detection = c(v_negative, v_positive)
)
thres <- 40
ggplot(d, aes(x = detection, color = outcome)) +
geom_density(position = "dodge", fill = NA, alpha = 0.5)
d_good <- d[d$outcome == "good", ]
dens_good <- density(d_good$detection)
d_g <- data.frame(x = dens_good$x, y = dens_good$y)
d_g_below <- d_g[d_g$x < thres, ]
d_g_above <- d_g[d_g$x > thres, ]
d_poor <- d[d$outcome == "poor", ]
dens_poor <- density(d_poor$detection)
d_p <- data.frame(x = dens_poor$x, y = dens_poor$y)
d_p_below <- d_p[d_p$x < thres, ]
d_p_above <- d_p[d_p$x > thres, ]
ggplot()+
geom_area(aes(x = x, y = y), color = "#F8766D", fill = "white", data = d_g_above)+
geom_area(aes(x = x, y = y), color = "#F8766D", fill = "#F8766D", data = d_g_below)
ggplot()+
geom_area(aes(x = x, y = y), color = "#00BFC4", fill = "white", data = d_p_below)+
geom_area(aes(x = x, y = y), color = "#00BFC4", fill = "#00BFC4", data = d_p_above)
vec_to_percent <- function(vec){
min_v <- min(vec)
max_v <- max(vec)
(vec - min_v) / (max_v - min_v) * 100
}
thre_f <- function(x){
judge <- ifelse(d$detection > x, "positive", "negative")
true_negative <- sum(d$outcome == "good" & judge == "negative")/nrow(d)
true_positive <- sum(d$outcome == "poor" & judge == "positive")/nrow(d)
c(threshold = x, true_negative = true_negative, true_positive = true_positive)
}
thre_vec <- seq(min(d$detection), max(d$detection), by = 0.1)
# これがROC（false_positiveを横軸，true_negativeを縦軸に取ったもの）っぽいもの（Ｘ軸が逆，多分true_positiveを取り，X軸を逆順にする必要がある）
